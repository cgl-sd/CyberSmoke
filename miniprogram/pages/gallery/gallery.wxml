<view class="page">
  <view class="head">
    <view class="head-title">烟款图鉴</view>
    <view class="head-sub">尼古丁余额：{{nicotine}}</view>
  </view>

  <view class="cig-list">
    <view
      class="cig-card {{item.equipped ? 'equipped' : ''}}"
      wx:for="{{list}}"
      wx:key="id"
      data-id="{{item.id}}"
      bindtap="onTapCig"
    >
      <view class="cig-head">
        <view class="cig-dot" style="background: {{item.dot}}"></view>
        <text class="cig-name">{{item.name}}</text>
        <text class="cig-mult">收益 ×{{item.mult}}</text>
      </view>
      <view class="cig-desc">{{item.desc}}</view>
      <view class="cig-foot">
        <text class="cig-price">{{item.owned ? '已拥有' : '价格 ' + item.price + ' 尼古丁'}}</text>
        <text
          class="cig-action {{item.equipped ? 'on' : (item.owned || item.afford) ? '' : 'off'}}"
        >{{item.equipped ? '使用中' : item.owned ? '点击装备' : item.afford ? '点击购买' : '尼古丁不足'}}</text>
      </view>
    </view>
  </view>

  <view class="foot">抽烟积累尼古丁，解锁更酷的烟款与粒子特效</view>
</view>
