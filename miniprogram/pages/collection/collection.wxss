/* 收藏页样式 */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
  background: #090a0c;
}

.title {
  font-size: 44rpx;
  color: #e8eeee;
  letter-spacing: 8rpx;
  font-weight: 300;
}

.sub {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #75f4d2;
  letter-spacing: 4rpx;
}

.grid {
  margin-top: 36rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 22rpx;
}

.card {
  width: calc((100% - 22rpx) / 2);
  background: rgba(232, 238, 238, 0.03);
  border: 1rpx solid rgba(232, 238, 238, 0.1);
  border-radius: 20rpx;
  padding: 26rpx;
  box-sizing: border-box;
  opacity: 0.55;
}

.card.on {
  opacity: 1;
  border-color: rgba(117, 244, 210, 0.45);
}

.card.rarity-UR.on {
  border-color: rgba(183, 148, 246, 0.6);
}

.ring-visual {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 4rpx solid #3a4145;
}

.ring-visual.vis-on {
  border-color: #e8eeee;
  box-shadow: 0 0 24rpx rgba(232, 238, 238, 0.35);
}

.rarity-UR .ring-visual.vis-on {
  border-color: #b794f6;
  box-shadow: 0 0 24rpx rgba(183, 148, 246, 0.5);
}

.name {
  margin-top: 18rpx;
  font-size: 30rpx;
  color: #e8eeee;
  letter-spacing: 2rpx;
}

.rarity {
  margin-top: 4rpx;
  font-size: 20rpx;
  color: #75f4d2;
  letter-spacing: 4rpx;
}

.desc {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #9aa5a9;
  line-height: 1.6;
  min-height: 70rpx;
}

.meta {
  margin-top: 12rpx;
  font-size: 20rpx;
  color: #75f4d2;
}

.meta.locked {
  color: #5c6468;
}

.foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  color: #5c6468;
}
