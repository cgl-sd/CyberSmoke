/* 技能页样式 */
.page {
  min-height: 100vh;
  padding: 40rpx 32rpx 60rpx;
  box-sizing: border-box;
}

.head-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #00ffd5;
  letter-spacing: 6rpx;
  text-shadow: 0 0 12rpx rgba(0, 255, 213, 0.6);
}

.head-sub {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8a8aa0;
}

.skill-list {
  margin-top: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.skill-card {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(138, 138, 160, 0.25);
  border-radius: 20rpx;
  padding: 28rpx;
}

.skill-card.on {
  border-color: rgba(0, 255, 213, 0.6);
  box-shadow: 0 0 24rpx rgba(0, 255, 213, 0.15);
}

.skill-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.skill-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8e8f0;
}

.skill-card.on .skill-name {
  color: #00ffd5;
}

.skill-state {
  font-size: 20rpx;
  color: #8a8aa0;
}

.skill-card.on .skill-state {
  color: #00ffd5;
}

.skill-desc {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8a8aa0;
  line-height: 1.6;
}

.skill-bar {
  margin-top: 20rpx;
  height: 10rpx;
  background: rgba(255, 255, 255, 0.08);
  border-radius: 5rpx;
  overflow: hidden;
}

.skill-fill {
  height: 100%;
  background: linear-gradient(90deg, #00ffd5, #ff2e88);
}

.foot {
  margin-top: 48rpx;
  text-align: center;
  font-size: 20rpx;
  color: #55556a;
}
