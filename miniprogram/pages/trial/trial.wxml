<view class="page">
  <view class="head">
    <view class="head-title">赛博试炼</view>
    <view class="head-sub">顺序闯关 · 已完成 {{doneCount}}/{{total}} 关</view>
  </view>

  <view class="trial-list">
    <view class="trial-card {{item.state}}" wx:for="{{list}}" wx:key="id">
      <view class="trial-top">
        <text class="trial-name">{{item.state === 'done' ? '✅' : item.state === 'current' ? '🎯' : '🔒'}} {{item.name}}</text>
        <text class="trial-reward">+{{item.reward}}</text>
      </view>
      <view class="trial-desc">{{item.desc}}</view>
      <view class="trial-state">
        {{item.state === 'done' ? '已完成，奖励入账' : item.state === 'current' ? '进行中 · 回首页抽烟挑战' : '完成上一关后解锁'}}
      </view>
    </view>
  </view>

  <view class="foot">奖励自动发放 · 全部通关可解锁传说级「清醒试炼」</view>
</view>
