<view class="page {{coughing ? 'shake' : ''}}">
  <canvas type="2d" id="smokeCanvas" class="smoke-canvas"></canvas>

  <view class="cough-overlay" wx:if="{{coughing}}"></view>

  <view
    class="gesture-layer"
    bindtouchstart="onTouchStart"
    bindtouchmove="onTouchMove"
    bindtouchend="onTouchEnd"
    bindtouchcancel="onTouchEnd"
  >
    <view class="header">
      <view class="sound-toggle" catchtap="onToggleSound">{{soundOn ? '🔊' : '🔇'}}</view>
      <view class="title-main">{{titleName}}</view>
      <view class="title-sub">赛博吸烟 · 纯属虚拟 · 不提倡吸烟</view>
      <view class="stats-bar">
        <view class="stat" catchtap="goGallery">
          <text class="stat-num">{{cigaretteCount}}</text>
          <text class="stat-label">已抽支数</text>
        </view>
        <view class="stat" catchtap="goGallery">
          <text class="stat-num nicotine">{{nicotine}}</text>
          <text class="stat-label">尼古丁</text>
        </view>
        <view class="stat" catchtap="goSkills">
          <text class="stat-num streak">{{streakDays}}</text>
          <text class="stat-label">晨烟连击</text>
        </view>
      </view>
    </view>

    <!-- 状态区：焦油 / 烟灰炉（触摸不透传） -->
    <view class="chips" catchtouchstart="noop" catchtouchend="noop" catchtouchcancel="noop">
      <view class="chip">
        <view class="chip-title">
          <text>焦油 {{tar}}/100</text>
          <text wx:if="{{tar > 0}}" class="mint-btn {{nicotine >= 50 ? '' : 'dim'}}" catchtap="onClearTar">🧊 50</text>
        </view>
        <view class="tar-bar">
          <view class="tar-fill {{coughing ? 'cough' : ''}}" style="width: {{tarPercent}}%"></view>
        </view>
      </view>
      <view class="chip">
        <view class="chip-title">
          <text>烟灰炉 🔥×{{burningCount}}</text>
          <text class="butt-num">🚬{{butts}}</text>
        </view>
        <view class="ash-row">
          <text class="ash-num">烟灰 {{ash}}</text>
          <text class="collect-btn {{ash >= 2 ? '' : 'dim'}}" catchtap="onCollectAsh">收烟灰</text>
        </view>
      </view>
    </view>

    <view class="stage">
      <view class="cig {{phase === 'lit' || phase === 'inhaling' ? 'cig-lit' : ''}}">
        <view class="cig-flame {{phase === 'igniting' || phase === 'lit' ? 'flame-show' : ''}}"></view>
        <view class="cig-stick">
          <view
            class="cig-ember"
            style="{{phase === 'inhaling' ? 'transform: scale(' + (1 + chargePercent / 100) + ');' : ''}}"
          ></view>
          <view class="cig-band"></view>
          <view class="cig-body"></view>
        </view>
      </view>

      <view class="hint">{{hintText}}</view>

      <view class="charge-wrap" wx:if="{{phase === 'inhaling'}}">
        <view class="charge-bar">
          <view class="charge-fill" style="width: {{chargePercent}}%"></view>
        </view>
        <view class="charge-label">
          烟雾蓄力 {{chargePercent}}%
          <text wx:if="{{ringCount > 0}}" class="ring-label">· 烟圈 ×{{ringCount}}</text>
        </view>
      </view>
    </view>

    <view class="dock">
      <button wx:if="{{phase === 'idle'}}" class="light-btn" bindtap="onLightUp">{{lightBtnText}}</button>
      <view wx:else class="light-btn light-btn-ghost">
        <view class="phase-text">{{phase === 'igniting' ? '🔥' : phase === 'lit' ? '🚬' : '💨'}}</view>
      </view>
      <view class="cig-name">当前烟款：{{currentCigName}} · 收益 ×{{currentCigMult}}</view>

      <!-- 戒烟挑战 -->
      <view class="quit-area" catchtap="noop">
        <view wx:if="{{sober}}" class="quit-badge">🏆 清醒者 · 已戒烟成功</view>
        <block wx:elif="{{quitActive}}">
          <view class="quit-progress">🕯 戒烟挑战中 · 第 {{quitDayNo}}/7 天</view>
          <view class="quit-giveup" catchtap="onGiveUpQuit">放弃挑战</view>
        </block>
        <view wx:elif="{{quitUnlocked}}" class="quit-btn" catchtap="onStartQuit">
          🕯 开始戒烟挑战 · 7 天一支不抽 → 终极称号「清醒者」
        </view>
      </view>
    </view>
  </view>
</view>
