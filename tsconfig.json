{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "removeComments": true,
    "sourceMap": false,
    "rootDir": ".",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "lib": ["ES2020"]
  },
  "include": ["typings/**/*.d.ts", "miniprogram/**/*.ts"],
  "exclude": ["node_modules", "tmp", "reference"]
}
